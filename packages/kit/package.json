{
  "name": "@ghostsync/kit",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "GhostSync Kit — reusable offline sync SDK.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
