{
  "name": "@ghostsync/qr-transfer",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "GhostSync QR transfer: static QR frame codec, symbol builder and camera scan session for .gscap capsules.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
