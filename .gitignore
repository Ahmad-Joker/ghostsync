# Dependencies
node_modules/

# Build outputs
# (includes the offline-assets generated harness Service Worker + precache
#  manifest, emitted under packages/persist/harness/dist — regenerated by
#  `pnpm.cmd -F @ghostsync/persist build:harness`, never committed)
dist/
build/
.build/
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Playwright browser-test artifacts (generated by @ghostsync/persist test:browser)
playwright-report/
test-results/
.playwright/

# Local environment files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# .kiro/ is tracked in Git — do not ignore
